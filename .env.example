NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id-here
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Address-based ballot matching (see docs/address-matching-strategy.md).
# Free tier, no credit card: https://www.geoapify.com/ — create a project,
# then restrict the key by HTTP referrer (your domain) in the Geoapify
# dashboard before using it in production. Without this, the address
# lookup input degrades to a "not configured" message; the rest of the
# guide is unaffected.
NEXT_PUBLIC_GEOAPIFY_API_KEY=your-geoapify-key-here

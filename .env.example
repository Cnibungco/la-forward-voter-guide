NEXT_PUBLIC_SANITY_PROJECT_ID=wcogcahu
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Secret Sanity uses to sign the publish webhook (see docs/backend-strategy.md §13).
# Generate a long random string, set the same value in Vercel (Production)
# and as the webhook secret in manage.sanity.io for project wcogcahu.
# The route rejects anything not signed with it. Never commit the real value.
SANITY_REVALIDATE_SECRET=

# Address-based ballot matching (see docs/address-matching-strategy.md).
# Free tier, no credit card: https://www.geoapify.com/ — create a project,
# then restrict the key by HTTP referrer (your domain) in the Geoapify
# dashboard before using it in production. Without this, the address
# lookup input degrades to a "not configured" message; the rest of the
# guide is unaffected.
NEXT_PUBLIC_GEOAPIFY_API_KEY=your-geoapify-key-here

# Optional. Google Analytics 4 Measurement ID (G-XXXXXXXX). Leave unset until
# you have one. In Vercel, set this on Production only — not Preview — so
# draft URLs do not pollute reports. After enabling, in GA4 Admin turn off
# Enhanced Measurement → form interactions (the address field is a form).
# Keep "page changes based on browser history events" on.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
